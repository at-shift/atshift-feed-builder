msgstr "必須"

#: includes/class-atshift-feed-builder-admin.php:490
msgid "Generated automatically"
msgstr "自動生成"

#: includes/class-atshift-feed-builder-admin.php:494
#: includes/class-atshift-feed-builder-admin.php:561
