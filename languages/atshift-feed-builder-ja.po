#: includes/class-atshift-feed-builder-admin.php:696
#: includes/class-atshift-feed-builder-admin.php:698
#: includes/class-atshift-feed-builder-admin.php:702
msgid "Enter the field name used by the plugin."
msgstr "プラグインで使用しているフィールド名を入力してください。"

#: includes/class-atshift-feed-builder-admin.php:736
msgid "Publish this feed to create its public URL."
msgstr "公開フィードURLを作成するには、このフィードを公開してください。"

#: includes/class-atshift-feed-builder-admin.php:743
#: includes/class-atshift-feed-builder-admin.php:1125
msgid "Standard feed disabled"
msgstr "標準フィードは無効です"

#: includes/class-atshift-feed-builder-admin.php:743
msgid "The selected WordPress feed URL returns not found and is not advertised in the page head."
msgstr "選択したWordPressフィードURLは「見つかりません」を返し、ページのheadにも掲載しません。"

#: includes/class-atshift-feed-builder-admin.php:747
msgid "Existing term feed URLs"
msgstr "既存のターム別フィードURL"

#: includes/class-atshift-feed-builder-admin.php:747
msgid "Each category, tag, or taxonomy term keeps its own WordPress feed URL."
msgstr "カテゴリー、タグ、タクソノミーの各タームは、それぞれ既存のWordPressフィードURLを維持します。"

#: includes/class-atshift-feed-builder-admin.php:760
msgid "Check the current settings without saving them."
msgstr "保存せずに現在の設定を確認できます。"

#: includes/class-atshift-feed-builder-admin.php:763
msgid "Preview feed"
msgstr "フィードをプレビュー"

#: includes/class-atshift-feed-builder-admin.php:765
msgid "The preview uses the first item in the current feed order."
msgstr "プレビューには、現在のフィード順で先頭の項目を使用します。"

#: includes/class-atshift-feed-builder-admin.php:770
msgid "Feed preview"
msgstr "フィードプレビュー"

#: includes/class-atshift-feed-builder-admin.php:773
#: includes/class-atshift-feed-builder-admin.php:775
msgid "Close preview"
msgstr "プレビューを閉じる"

#: includes/class-atshift-feed-builder-admin.php:779
msgid "Preview view"
msgstr "プレビュー表示"

#: includes/class-atshift-feed-builder-admin.php:781
msgid "Reader preview"
msgstr "表示プレビュー"

#: includes/class-atshift-feed-builder-admin.php:784
msgid "Source code"
msgstr "ソースコード"

#: includes/class-atshift-feed-builder-admin.php:796
msgid "Copy output"
msgstr "出力をコピー"

#: includes/class-atshift-feed-builder-admin.php:807
msgid "You are not allowed to preview feeds."
msgstr "フィードをプレビューする権限がありません。"

#: includes/class-atshift-feed-builder-admin.php:813
