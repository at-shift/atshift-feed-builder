msgid "RSS 2.0"
msgstr "RSS 2.0"

#: includes/class-atshift-feed-builder-schema.php:29
msgid "For feed readers and broadly compatible content syndication."
msgstr "フィードリーダーなど、幅広い互換性が必要なコンテンツ配信向けです。"

#: includes/class-atshift-feed-builder-schema.php:32
msgid "JSON Feed 1.1"
msgstr "JSON Feed 1.1"

#: includes/class-atshift-feed-builder-schema.php:33
msgid "For applications, external services, and structured data consumers."
msgstr ""
"アプリケーション、外部サービス、構造化データを利用するシステム向けです。"

#: includes/class-atshift-feed-builder-schema.php:96
msgid "RSS version"
msgstr "RSSバージョン"

#: includes/class-atshift-feed-builder-schema.php:96
msgid "Always output as RSS 2.0."
msgstr "常にRSS 2.0として出力します。"

#: includes/class-atshift-feed-builder-schema.php:97
#: includes/class-atshift-feed-builder-schema.php:123
msgid "Feed title"
msgstr "フィードタイトル"

