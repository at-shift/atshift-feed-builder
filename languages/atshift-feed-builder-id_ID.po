#. Description of the plugin
#: atshift-feed-builder.php
msgid "Build safe RSS and JSON feeds from WordPress posts, custom fields, and author profile data."
msgstr "Buat umpan RSS dan JSON yang aman dari pos WordPress, ruas tersuai, dan data profil penulis."

