msgstr "Nama bidang ACF / SCF"

#: includes/adapters/class-atshift-feed-builder-acf-adapter.php:34
msgid "Enter the ACF or Secure Custom Fields field name or field key."
msgstr "Masukkan nama bidang atau kunci bidang ACF atau Secure Custom Fields."

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:18
msgid "Carbon Fields field"
msgstr "Bidang Carbon Fields"

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:30
msgid "Carbon Fields field name"
msgstr "Nama bidang Carbon Fields"

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:34
msgid "Enter the Carbon Fields post meta field name."
msgstr "Masukkan nama bidang metadata pos Carbon Fields."

#: includes/adapters/class-atshift-feed-builder-fields-adapter.php:24
msgid "atshift Fields"
msgstr "atshift Fields"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:18
msgid "Meta Box field"
msgstr "Bidang Meta Box"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:30
msgid "Meta Box field ID"
msgstr "ID bidang Meta Box"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:34
msgid "Enter the Meta Box field ID. Standard post storage is supported."
msgstr "Masukkan ID bidang Meta Box. Penyimpanan pos standar didukung."

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:18
msgid "Pods field"
msgstr "Bidang Pods"

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:35
msgid "Pods field name"
msgstr "Nama bidang Pods"

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:39
msgid "Enter the Pods field name. The current post type and post ID are detected automatically."
msgstr "Masukkan nama bidang Pods. Tipe pos dan ID pos saat ini dideteksi secara otomatis."

#: includes/adapters/class-atshift-feed-builder-post-meta-adapter.php:18
msgid "WordPress custom field (post_meta)"
msgstr "Ruas tersuai WordPress (post_meta)"

#: includes/adapters/class-atshift-feed-builder-post-meta-adapter.php:35
