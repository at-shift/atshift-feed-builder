#. Description of the plugin
#: atshift-feed-builder.php
msgid ""
"Build safe RSS and JSON feeds from WordPress posts, custom fields, and "
"author profile data."
msgstr "使用 WordPress 文章、自定义字段和作者个人资料数据构建安全的 RSS 和 JSON 订阅源。"

#. Author of the plugin
#: atshift-feed-builder.php
msgid "@shift"
msgstr "@shift"

#. Author URI of the plugin
#: atshift-feed-builder.php
msgid "https://cfs.at-shift.net/en/"
msgstr "https://cfs.at-shift.net/en/"

