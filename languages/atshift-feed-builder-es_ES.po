#. Plugin Name of the plugin
#: atshift-feed-builder.php includes/class-atshift-feed-builder-plugin.php:126
msgid "atshift Feed Builder"
msgstr "atshift Feed Builder"

#. Plugin URI of the plugin
#: atshift-feed-builder.php
msgid "https://upf.at-shift.net/en/feed-builder/"
msgstr "https://upf.at-shift.net/en/feed-builder/"

#. Description of the plugin
#: atshift-feed-builder.php
msgid ""
"Build safe RSS and JSON feeds from WordPress posts, custom fields, and "
"author profile data."
msgstr "Crea feeds RSS y JSON seguros a partir de entradas de WordPress, campos personalizados y datos del perfil del autor."

#. Author of the plugin
#: atshift-feed-builder.php
msgid "@shift"
msgstr "@shift"

#. Author URI of the plugin
#: atshift-feed-builder.php
msgid "https://cfs.at-shift.net/en/"
msgstr "https://cfs.at-shift.net/en/"

#: includes/class-atshift-feed-builder-plugin.php:95
msgid "Settings"
msgstr "Ajustes"

#. translators: %s: Plugin version.
#: includes/class-atshift-feed-builder-plugin.php:126
#, php-format
msgid "Version %s"
msgstr "Versión %s"

#. translators: %s: Plugin author.
#: includes/class-atshift-feed-builder-plugin.php:131
#, php-format
msgid "By %s"
msgstr "Por %s"

#: includes/class-atshift-feed-builder-plugin.php:137
msgid "View details"
msgstr "Ver detalles"

#: includes/adapters/class-atshift-feed-builder-acf-adapter.php:18
msgid "ACF / Secure Custom Fields field"
msgstr "Campo de ACF / Secure Custom Fields"

#: includes/adapters/class-atshift-feed-builder-acf-adapter.php:30
msgid "ACF / SCF field name"
msgstr "Nombre del campo de ACF / SCF"

#: includes/adapters/class-atshift-feed-builder-acf-adapter.php:34
msgid "Enter the ACF or Secure Custom Fields field name or field key."
msgstr "Introduce el nombre o la clave del campo de ACF o Secure Custom Fields."

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:18
msgid "Carbon Fields field"
msgstr "Campo de Carbon Fields"

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:30
msgid "Carbon Fields field name"
msgstr "Nombre del campo de Carbon Fields"

#: includes/adapters/class-atshift-feed-builder-carbon-fields-adapter.php:34
msgid "Enter the Carbon Fields post meta field name."
msgstr "Introduce el nombre del campo de metadatos de entrada de Carbon Fields."

#: includes/adapters/class-atshift-feed-builder-fields-adapter.php:24
msgid "atshift Fields"
msgstr "atshift Fields"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:18
msgid "Meta Box field"
msgstr "Campo de Meta Box"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:30
msgid "Meta Box field ID"
msgstr "ID del campo de Meta Box"

#: includes/adapters/class-atshift-feed-builder-meta-box-adapter.php:34
msgid "Enter the Meta Box field ID. Standard post storage is supported."
msgstr "Introduce el ID del campo de Meta Box. Se admite el almacenamiento estándar de los metadatos de entrada."

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:18
msgid "Pods field"
msgstr "Campo de Pods"

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:35
msgid "Pods field name"
msgstr "Nombre del campo de Pods"

#: includes/adapters/class-atshift-feed-builder-pods-adapter.php:39
msgid ""
"Enter the Pods field name. The current post type and post ID are detected "
"automatically."
msgstr "Introduce el nombre del campo de Pods. Se detectan automáticamente el tipo de contenido actual y el ID de la entrada."

#: includes/adapters/class-atshift-feed-builder-post-meta-adapter.php:18
msgid "WordPress custom field (post_meta)"
msgstr "Campo personalizado de WordPress (post_meta)"

#: includes/adapters/class-atshift-feed-builder-post-meta-adapter.php:35
#: includes/class-atshift-feed-builder-admin.php:405
#: includes/class-atshift-feed-builder-admin.php:425
msgid "Custom field key"
msgstr "Clave del campo personalizado"

#: includes/adapters/class-atshift-feed-builder-post-meta-adapter.php:39
msgid ""
"Enter a public post_meta key. This covers Custom Field Template and other "
"plugins that use standard post meta."
msgstr "Introduce una clave pública de post_meta. Esto incluye Custom Field Template y otros plugins que utilizan metadatos de entrada estándar."

#: includes/adapters/class-atshift-feed-builder-upf-adapter.php:21
msgid "atshift User Profile Fields (post author)"
msgstr "atshift User Profile Fields (autor de la entrada)"

#: includes/class-atshift-feed-builder-admin.php:38
#: includes/class-atshift-feed-builder-admin.php:39
#: includes/class-atshift-feed-builder-plugin.php:128
msgid "Add New Feed"
msgstr "Añadir nuevo feed"

#: includes/class-atshift-feed-builder-admin.php:69
msgid "Choose how to publish the feed"
msgstr "Elige cómo publicar el feed"

#: includes/class-atshift-feed-builder-admin.php:70
msgid ""
"Keep an existing WordPress feed URL and replace its output, or add a "
"separate feed for a new purpose."
msgstr "Conserva la URL de un feed existente de WordPress y sustituye su salida, o añade un feed independiente para un nuevo fin."

#: includes/class-atshift-feed-builder-admin.php:72
msgid "Replace a WordPress standard feed"
msgstr "Sustituir un feed estándar de WordPress"

#: includes/class-atshift-feed-builder-admin.php:73
msgid ""
"The existing RSS URL stays the same. WordPress continues to advertise that "
"URL in the page head, while atshift Feed Builder controls its content."
msgstr "La URL RSS existente no cambia. WordPress sigue anunciando esa URL en el <head> de la página, mientras atshift Feed Builder controla su contenido."

#: includes/class-atshift-feed-builder-admin.php:79
msgid "Standard feed to replace"
msgstr "Feed estándar que se sustituirá"

#: includes/class-atshift-feed-builder-admin.php:85
msgid "Create standard RSS feed"
msgstr "Crear feed RSS estándar"

#: includes/class-atshift-feed-builder-admin.php:90
msgid "Add a custom feed"
msgstr "Añadir un feed personalizado"

#: includes/class-atshift-feed-builder-admin.php:91
msgid ""
"Create a separate URL with its own slug for a specific service, audience, or "
"use case."
msgstr "Crea una URL independiente con su propio slug para un servicio, público o caso de uso específico."

#. translators: %s: Feed format name.
#: includes/class-atshift-feed-builder-admin.php:106
#, php-format
msgid "Create %s feed"
msgstr "Crear feed %s"

#: includes/class-atshift-feed-builder-admin.php:121
msgid "You are not allowed to create feeds."
msgstr "No tienes permisos para crear feeds."

#: includes/class-atshift-feed-builder-admin.php:132
msgid "Invalid feed format."
msgstr "El formato del feed no es válido."

#: includes/class-atshift-feed-builder-admin.php:135
msgid "Invalid standard feed destination."
msgstr "El destino del feed estándar no es válido."

#. translators: %s: Feed format name.
#: includes/class-atshift-feed-builder-admin.php:142
#, php-format
msgid "New %s feed"
msgstr "Nuevo feed %s"

#: includes/class-atshift-feed-builder-admin.php:155
msgid "The feed could not be created."
msgstr "No se ha podido crear el feed."

#: includes/class-atshift-feed-builder-admin.php:178
msgid "Feed source"
msgstr "Origen del feed"

#. translators: %s: Feed format name.
#: includes/class-atshift-feed-builder-admin.php:183
#, php-format
msgid "%s output mapping"
msgstr "Asignación de salida de %s"

#: includes/class-atshift-feed-builder-admin.php:191
#: includes/class-atshift-feed-builder-admin.php:1108
msgid "Feed URL"
msgstr "URL del feed"

#: includes/class-atshift-feed-builder-admin.php:192
msgid "Preview"
msgstr "Vista previa"

#: includes/class-atshift-feed-builder-admin.php:203
msgid "Help"
msgstr "Ayuda"

#: includes/class-atshift-feed-builder-admin.php:211
msgid ""
"The most recent update time in the feed, calculated automatically. Services "
"use it to detect changes."
msgstr "La hora de actualización más reciente del feed, calculada automáticamente. Los servicios la utilizan para detectar cambios."

#: includes/class-atshift-feed-builder-admin.php:212
#: includes/class-atshift-feed-builder-admin.php:213
msgid ""
"The permanent public URL of this feed. It is generated automatically and "
"tells services which URL is authoritative."
msgstr "La URL pública permanente de este feed. Se genera automáticamente e indica a los servicios cuál es la URL de referencia."

#: includes/class-atshift-feed-builder-admin.php:214
#: includes/class-atshift-feed-builder-admin.php:215
msgid ""
"The person or organization responsible for operating and publishing the "
"feed, not necessarily the article author."
msgstr "La persona u organización responsable de gestionar y publicar el feed, que no tiene por qué ser el autor del artículo."

#: includes/class-atshift-feed-builder-admin.php:216
msgid ""
"A feed item is one published post included in the feed. This container is "
"created automatically."
msgstr "Un elemento del feed es una entrada publicada incluida en el feed. Este contenedor se crea automáticamente."

#: includes/class-atshift-feed-builder-admin.php:217
#: includes/class-atshift-feed-builder-admin.php:218
msgid ""
"Feed readers use this value to recognize the same post after an update and "
"avoid duplicates. It should not change after publication."
msgstr "Los lectores de feeds utilizan este valor para reconocer la misma entrada después de una actualización y evitar duplicados. No debería cambiar después de la publicación."

#: includes/class-atshift-feed-builder-admin.php:219
#: includes/class-atshift-feed-builder-admin.php:220
msgid ""
"The public page readers open for this post. Custom post types also use their "
"normal permalink."
msgstr "La página pública que los lectores abren para esta entrada. Los tipos de contenido personalizados también utilizan su enlace permanente habitual."

#: includes/class-atshift-feed-builder-admin.php:221
#: includes/class-atshift-feed-builder-admin.php:222
msgid "The person credited with writing or creating the post."
msgstr "La persona a la que se atribuye la redacción o creación de la entrada."

#: includes/class-atshift-feed-builder-admin.php:223
#: includes/class-atshift-feed-builder-admin.php:224
msgid ""
"An optional person who checked or supervised the content. Leave it out when "
"there is no reviewer."
msgstr "Una persona opcional que revisó o supervisó el contenido. Omítela si no hay revisor."

#: includes/class-atshift-feed-builder-admin.php:225
#: includes/class-atshift-feed-builder-admin.php:226
msgid ""
"The original or related source behind the post. Use this when the WordPress "
"post summarizes information published elsewhere."
msgstr "La fuente original o relacionada en la que se basa la entrada. Utilízala cuando la entrada de WordPress resuma información publicada en otro lugar."

#: includes/class-atshift-feed-builder-admin.php:227
#: includes/class-atshift-feed-builder-admin.php:228
msgid ""
"Classification labels attached to the post. They help readers and services "
"group or filter items."
msgstr "Etiquetas de clasificación asociadas a la entrada. Ayudan a los lectores y servicios a agrupar o filtrar elementos."

#: includes/class-atshift-feed-builder-admin.php:229
msgid ""
"The representative image for the item. A fallback can be used when the post "
"has no featured image."
msgstr "La imagen representativa del elemento. Puede utilizarse una alternativa cuando la entrada no tiene imagen destacada."

#: includes/class-atshift-feed-builder-admin.php:269
msgid "Equals"
msgstr "Es igual a"

#: includes/class-atshift-feed-builder-admin.php:270
msgid "Does not equal"
msgstr "No es igual a"

#: includes/class-atshift-feed-builder-admin.php:271
msgid "Contains"
msgstr "Contiene"

#: includes/class-atshift-feed-builder-admin.php:272
msgid "Exists"
msgstr "Existe"

#: includes/class-atshift-feed-builder-admin.php:273
msgid "Does not exist"
msgstr "No existe"

#: includes/class-atshift-feed-builder-admin.php:279
msgid "Output format"
msgstr "Formato de salida"

#: includes/class-atshift-feed-builder-admin.php:281
msgid "The format is fixed for this feed."
msgstr "El formato es fijo para este feed."

#: includes/class-atshift-feed-builder-admin.php:286
msgid "Publication method"
msgstr "Método de publicación"

#: includes/class-atshift-feed-builder-admin.php:289
msgid "Customize a standard feed"
msgstr "Personalizar un feed estándar"

#: includes/class-atshift-feed-builder-admin.php:289
msgid "Keep the WordPress URL and replace its RSS output."
msgstr "Conserva la URL de WordPress y sustituye su salida RSS."

#: includes/class-atshift-feed-builder-admin.php:290
msgid "Create a custom feed"
msgstr "Crear un feed personalizado"

#: includes/class-atshift-feed-builder-admin.php:290
msgid "Publish at a separate URL with a custom slug."
msgstr "Publica en una URL independiente con un slug personalizado."

#: includes/class-atshift-feed-builder-admin.php:291
msgid "Disable a standard feed"
msgstr "Desactivar un feed estándar"

#: includes/class-atshift-feed-builder-admin.php:291
msgid "Remove its discovery link and return not found at that RSS URL."
msgstr "Elimina su enlace de descubrimiento y devuelve «no encontrado» en esa URL RSS."

#: includes/class-atshift-feed-builder-admin.php:295
msgid ""
"JSON Feed uses a custom URL because WordPress does not provide a standard "
"JSON Feed endpoint."
msgstr "JSON Feed utiliza una URL personalizada porque WordPress no proporciona un endpoint estándar de JSON Feed."

#: includes/class-atshift-feed-builder-admin.php:301
msgid "Target WordPress standard feed"
msgstr "Feed estándar de WordPress de destino"

#: includes/class-atshift-feed-builder-admin.php:307
msgid ""
"Choose the standard WordPress feed affected by this setting. Category, tag, "
"and taxonomy targets use each term's existing feed URL."
msgstr "Elige el feed estándar de WordPress afectado por este ajuste. Los destinos de categoría, etiqueta y taxonomía utilizan la URL de feed existente de cada término."

#: includes/class-atshift-feed-builder-admin.php:313
msgid "Feed slug"
msgstr "Slug del feed"

#: includes/class-atshift-feed-builder-admin.php:313
msgid ""
"A short identifier used in the public feed URL. Use lowercase letters, "
"numbers, and hyphens."
msgstr "Un identificador corto utilizado en la URL pública del feed. Usa letras minúsculas, números y guiones."

#: includes/class-atshift-feed-builder-admin.php:315
msgid "Changing this value changes the public feed URL."
msgstr "Al cambiar este valor, cambia la URL pública del feed."

#: includes/class-atshift-feed-builder-admin.php:317
msgid "Publish this feed"
msgstr "Publicar este feed"

#: includes/class-atshift-feed-builder-admin.php:317
msgid ""
"Adds an alternate feed link to the page <head> so browsers and external "
"services can discover this custom feed."
msgstr "Añade un enlace alternativo al feed en el <head> de la página para que los navegadores y servicios externos puedan descubrir este feed personalizado."

#: includes/class-atshift-feed-builder-admin.php:322
msgid "Content types"
msgstr "Tipos de contenido"

#: includes/class-atshift-feed-builder-admin.php:322
msgid ""
"Choose which kinds of WordPress content become feed items. Selecting a "
"custom post type includes its published entries."
msgstr "Elige qué tipos de contenido de WordPress se convierten en elementos del feed. Al seleccionar un tipo de contenido personalizado, se incluyen sus entradas publicadas."

#: includes/class-atshift-feed-builder-admin.php:326
msgid "WordPress content"
msgstr "Contenido de WordPress"

#: includes/class-atshift-feed-builder-admin.php:327
msgid "Custom post types"
msgstr "Tipos de contenido personalizados"

#: includes/class-atshift-feed-builder-admin.php:327
msgid "No public custom post types are currently registered."
msgstr "Actualmente no hay ningún tipo de contenido personalizado público registrado."

#: includes/class-atshift-feed-builder-admin.php:354
msgid "Feed content filters"
msgstr "Filtros de contenido del feed"

#: includes/class-atshift-feed-builder-admin.php:354
msgid ""
"These settings limit which published posts are included in the feed. They do "
"not change the values output for each item."
msgstr "Estos ajustes limitan qué entradas publicadas se incluyen en el feed. No cambian los valores que se muestran para cada elemento."

#: includes/class-atshift-feed-builder-admin.php:357
msgid "Active"
msgstr "Activo"

#: includes/class-atshift-feed-builder-admin.php:363
msgid ""
"Choose which posts are included by author, taxonomy term, or custom field "
"value. Different filter groups must all match; within each taxonomy, any "
"selected term can match."
msgstr "Elige qué entradas se incluyen por autor, término de taxonomía o valor de campo personalizado. Todos los grupos de filtros deben coincidir; dentro de cada taxonomía, puede coincidir cualquiera de los términos seleccionados."

#: includes/class-atshift-feed-builder-admin.php:366
msgid "Authors"
msgstr "Autores"

#: includes/class-atshift-feed-builder-admin.php:366
msgid "Include posts written by the selected authors."
msgstr "Incluye las entradas escritas por los autores seleccionados."

#: includes/class-atshift-feed-builder-admin.php:378
msgid "Taxonomy terms"
msgstr "Términos de taxonomía"

#: includes/class-atshift-feed-builder-admin.php:378
msgid ""
"Include posts assigned to the selected categories, tags, or custom taxonomy "
"terms."
msgstr "Incluye las entradas asignadas a las categorías, etiquetas o términos de taxonomías personalizadas seleccionados."

#: includes/class-atshift-feed-builder-admin.php:380
msgid "No public taxonomy terms are currently registered."
msgstr "Actualmente no hay ningún término de taxonomía público registrado."

#: includes/class-atshift-feed-builder-admin.php:401
msgid "Custom field conditions"
msgstr "Condiciones de campos personalizados"

#: includes/class-atshift-feed-builder-admin.php:401
msgid "Include posts by matching a public custom field key and value."
msgstr "Incluye entradas que coincidan con una clave y un valor de campo personalizado público."

#: includes/class-atshift-feed-builder-admin.php:406
#: includes/class-atshift-feed-builder-admin.php:426
msgid "Comparison"
msgstr "Comparación"

#: includes/class-atshift-feed-builder-admin.php:411
#: includes/class-atshift-feed-builder-admin.php:431
msgid "Value"
msgstr "Valor"

#: includes/class-atshift-feed-builder-admin.php:412
#: includes/class-atshift-feed-builder-admin.php:414
#: includes/class-atshift-feed-builder-admin.php:432
#: includes/class-atshift-feed-builder-admin.php:434
msgid "Remove condition"
msgstr "Eliminar condición"

#: includes/class-atshift-feed-builder-admin.php:421
msgid "Add condition"
msgstr "Añadir condición"

#: includes/class-atshift-feed-builder-admin.php:445
msgid "Number of items"
msgstr "Número de elementos"

#: includes/class-atshift-feed-builder-admin.php:445
msgid "The maximum number of posts included each time the feed is generated."
msgstr "El número máximo de entradas incluidas cada vez que se genera el feed."

#: includes/class-atshift-feed-builder-admin.php:450
msgid "Order items by"
msgstr "Ordenar elementos por"

#: includes/class-atshift-feed-builder-admin.php:450
msgid ""
"Choose whether newly published posts or recently updated posts appear first."
msgstr "Elige si aparecen primero las entradas recién publicadas o las actualizadas recientemente."

#: includes/class-atshift-feed-builder-admin.php:452
#: includes/class-atshift-feed-builder-admin.php:612
#: includes/class-atshift-feed-builder-schema.php:114
#: includes/class-atshift-feed-builder-schema.php:139
msgid "Published date"
msgstr "Fecha de publicación"

#: includes/class-atshift-feed-builder-admin.php:453
#: includes/class-atshift-feed-builder-admin.php:613
#: includes/class-atshift-feed-builder-schema.php:140
msgid "Modified date"
msgstr "Fecha de modificación"

#: includes/class-atshift-feed-builder-admin.php:458
msgid "Cache lifetime (seconds)"
msgstr "Duración de la caché (segundos)"

#: includes/class-atshift-feed-builder-admin.php:458
msgid ""
"How long generated output is reused before checking WordPress for changes. "
"For example, 900 seconds is 15 minutes."
msgstr "Tiempo durante el que se reutiliza la salida generada antes de comprobar si hay cambios en WordPress. Por ejemplo, 900 segundos son 15 minutos."

#: includes/class-atshift-feed-builder-admin.php:471
msgid ""
"Choose a value source for each output field. Field-specific choices appear "
"only when they are needed."
msgstr "Elige un origen de valores para cada campo de salida. Las opciones específicas de cada campo solo aparecen cuando son necesarias."

#: includes/class-atshift-feed-builder-admin.php:472
msgid "Feed information"
msgstr "Información del feed"

#: includes/class-atshift-feed-builder-admin.php:472
msgid "Each item"
msgstr "Cada elemento"

#: includes/class-atshift-feed-builder-admin.php:483
msgid "Required"
msgstr "Obligatorio"

#: includes/class-atshift-feed-builder-admin.php:490
msgid "Generated automatically"
msgstr "Generado automáticamente"

#: includes/class-atshift-feed-builder-admin.php:494
#: includes/class-atshift-feed-builder-admin.php:561
msgid "Fixed value"
msgstr "Valor fijo"

#: includes/class-atshift-feed-builder-admin.php:498
msgid "If the primary value is empty"
msgstr "Si el valor principal está vacío"

#: includes/class-atshift-feed-builder-admin.php:501
msgid "Fallback URL"
msgstr "URL alternativa"

#: includes/class-atshift-feed-builder-admin.php:544
msgid "Value source"
msgstr "Origen del valor"

#: includes/class-atshift-feed-builder-admin.php:545
msgid "WordPress values"
msgstr "Valores de WordPress"

#: includes/class-atshift-feed-builder-admin.php:551
msgid "Custom values"
msgstr "Valores personalizados"

#: includes/class-atshift-feed-builder-admin.php:560
msgid "Other"
msgstr "Otros"

#: includes/class-atshift-feed-builder-admin.php:563
msgid "Do not output"
msgstr "No incluir en la salida"

#: includes/class-atshift-feed-builder-admin.php:566
msgid "Unavailable source (selection preserved)"
msgstr "Origen no disponible (se conserva la selección)"

#: includes/class-atshift-feed-builder-admin.php:579
msgid "Unavailable field (selection preserved)"
msgstr "Campo no disponible (se conserva la selección)"

#: includes/class-atshift-feed-builder-admin.php:602
msgid "Site name"
msgstr "Nombre del sitio"

#: includes/class-atshift-feed-builder-admin.php:603
msgid "Site tagline"
msgstr "Descripción corta del sitio"

#: includes/class-atshift-feed-builder-admin.php:604
msgid "Site URL"
msgstr "URL del sitio"

#: includes/class-atshift-feed-builder-admin.php:605
msgid "Site language"
msgstr "Idioma del sitio"

#: includes/class-atshift-feed-builder-admin.php:606
msgid "Site icon URL"
msgstr "URL del icono del sitio"

#: includes/class-atshift-feed-builder-admin.php:607
#: includes/class-atshift-feed-builder-schema.php:105
#: includes/class-atshift-feed-builder-schema.php:135
msgid "Post title"
msgstr "Título de la entrada"

#: includes/class-atshift-feed-builder-admin.php:608
msgid "Post permalink"
msgstr "Enlace permanente de la entrada"

#: includes/class-atshift-feed-builder-admin.php:609
msgid "Stable post ID"
msgstr "ID estable de la entrada"

#: includes/class-atshift-feed-builder-admin.php:610
msgid "Post excerpt (generated from content if empty)"
msgstr "Extracto de la entrada (se genera a partir del contenido si está vacío)"

#: includes/class-atshift-feed-builder-admin.php:611
msgid "Post content (HTML)"
msgstr "Contenido de la entrada (HTML)"

#: includes/class-atshift-feed-builder-admin.php:614
msgid "Featured image URL"
msgstr "URL de la imagen destacada"

#: includes/class-atshift-feed-builder-admin.php:615
msgid "All public taxonomy terms"
msgstr "Todos los términos de taxonomías públicas"

#: includes/class-atshift-feed-builder-admin.php:616
msgid "Categories only"
msgstr "Solo categorías"

#: includes/class-atshift-feed-builder-admin.php:617
msgid "Tags only"
msgstr "Solo etiquetas"

#: includes/class-atshift-feed-builder-admin.php:618
msgid "Public custom taxonomy terms only"
msgstr "Solo términos de taxonomías personalizadas públicas"

#: includes/class-atshift-feed-builder-admin.php:619
msgid "Display name"
msgstr "Nombre para mostrar"

#: includes/class-atshift-feed-builder-admin.php:620
msgid "Author archive URL"
msgstr "URL del archivo del autor"

#: includes/class-atshift-feed-builder-admin.php:621
msgid "Avatar URL"
msgstr "URL del avatar"

